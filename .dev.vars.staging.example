# Secretos del entorno STAGING — proyecto Supabase cloud: investep-staging.
# Copiá a `.dev.vars.staging` (gitignored) y completá los valores.
# Lo usa `wrangler dev --env staging` (local). En deploy: `just secrets-staging` carga TODO como secrets.
# NUNCA commitear el `.dev.vars.staging` real (AGENTS.md §5).

SUPABASE_URL=https://<PROJECT_REF_STAGING>.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Token para proteger la documentación en staging (/openapi.json, /reference, /docs).
# openssl rand -hex 32
DOCS_TOKEN=

# Resend (envío de correo transaccional). API key del panel + remitente del dominio verificado.
# RESEND_FROM admite "Nombre <correo@tudominio>". Crear la key en https://resend.com/api-keys
RESEND_API_KEY=
RESEND_FROM=

# Bootstrap admin — SOLO para scripts CLI (provision-user, get-token). NUNCA llega al Worker.
# Usado por `just create-first-user --env staging` y `just token --env staging` sin argumentos.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
