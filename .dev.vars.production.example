# Secretos del entorno PRODUCTION (rama "main") — proyecto Supabase cloud: investep.
# Copiá a `.dev.vars.production` (gitignored) y completá los valores.
# Lo usa `wrangler dev --env production` (local). En deploy: `just secrets-production` carga TODO como secrets.
# NUNCA commitear el `.dev.vars.production` real (AGENTS.md §5).

SUPABASE_URL=https://<PROJECT_REF_PROD>.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Token para proteger la documentación en producción. Vacío = doc bloqueada.
# openssl rand -hex 32
DOCS_TOKEN=

# Resend (envío de correo transaccional). API key del panel + remitente del dominio verificado.
# RESEND_FROM admite "Nombre <correo@tudominio>". Crear la key en https://resend.com/api-keys
RESEND_API_KEY=
RESEND_FROM=
