# ---------------------------------------------------------------------------
# Supabase self-hosting (docker) — entorno LOCAL DEV.
# Copiá este archivo a `.env` (`cp .env.example .env`); el `.env` está gitignored.
# TODOS los valores acá son DEMO/PÚBLICOS (los mismos del CLI local de Supabase):
# seguros para local, NUNCA usar en staging/producción.
#
# Clave: el triple JWT_SECRET + ANON_KEY + SERVICE_ROLE_KEY es el mismo del CLI,
# así las credenciales de `.dev.vars` (que la API usa) las acepta este stack sin
# tener que tocar `.dev.vars`.
# ---------------------------------------------------------------------------

############
# Secrets / JWT — triple del CLI local de Supabase (demo, firmado HS256)
############
POSTGRES_PASSWORD=postgres
JWT_SECRET=super-secret-jwt-token-with-at-least-32-characters-long
ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0
SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImV4cCI6MTk4MzgxMjk5Nn0.EGIM96RAZx35lJzdJsyH-qQwv8Hdp7fsn3W0YpN81IU

# API keys opacas (sb_...) — no las usamos en local: vacías => Kong cae al modo legacy
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
JWT_KEYS=
JWT_JWKS=

# Dashboard (Studio) basic-auth
DASHBOARD_USERNAME=supabase
DASHBOARD_PASSWORD=supabase

# Otros secretos de servicios internos (demo upstream)
SECRET_KEY_BASE=UpNVntn3cDxHJpq99YMc1T1AQgQpc8kfYTuRgBiYa15BLrx8etQoXz3gZv1/u2oq
VAULT_ENC_KEY=your-32-character-encryption-key
PG_META_CRYPTO_KEY=your-encryption-key-32-chars-min

############
# Database — Postgres interno del stack
############
POSTGRES_HOST=db
POSTGRES_DB=postgres
POSTGRES_PORT=5432
# Pooler (Supavisor)
POOLER_PROXY_PORT_TRANSACTION=6543
POOLER_DEFAULT_POOL_SIZE=20
POOLER_MAX_CLIENT_CONN=100
POOLER_TENANT_ID=local-tenant
POOLER_DB_POOL_SIZE=5

############
# API Proxy (Kong) — publicado en el host en 127.0.0.1:54321 (igual que el CLI)
############
KONG_HTTP_PORT=54321
KONG_HTTPS_PORT=8443

############
# API (PostgREST)
############
PGRST_DB_SCHEMAS=public,storage,graphql_public
PGRST_DB_MAX_ROWS=1000
PGRST_DB_EXTRA_SEARCH_PATH=public

############
# Auth (GoTrue)
############
SITE_URL=http://localhost:3000
ADDITIONAL_REDIRECT_URLS=
JWT_EXPIRY=3600
DISABLE_SIGNUP=false
API_EXTERNAL_URL=http://localhost:54321
SUPABASE_PUBLIC_URL=http://localhost:54321

# Email auth — la API real manda correos por Resend, no por GoTrue.
# Los valores SMTP son stubs (no hay servidor de mail en el stack local).
MAILER_URLPATHS_CONFIRMATION=/auth/v1/verify
MAILER_URLPATHS_INVITE=/auth/v1/verify
MAILER_URLPATHS_RECOVERY=/auth/v1/verify
MAILER_URLPATHS_EMAIL_CHANGE=/auth/v1/verify
ENABLE_EMAIL_SIGNUP=true
ENABLE_EMAIL_AUTOCONFIRM=false
SMTP_ADMIN_EMAIL=admin@example.com
SMTP_HOST=supabase-mail
SMTP_PORT=2500
SMTP_USER=fake_mail_user
SMTP_PASS=fake_mail_password
SMTP_SENDER_NAME=fake_sender
ENABLE_ANONYMOUS_USERS=false
ENABLE_PHONE_SIGNUP=false
ENABLE_PHONE_AUTOCONFIRM=false

############
# Studio
############
STUDIO_DEFAULT_ORGANIZATION=Investep
STUDIO_DEFAULT_PROJECT=investep-app-api
OPENAI_API_KEY=

############
# Functions (edge-runtime)
############
FUNCTIONS_VERIFY_JWT=false

############
# Storage (file backend local) — S3 stub
############
GLOBAL_S3_BUCKET=stub
REGION=stub
STORAGE_TENANT_ID=stub
S3_PROTOCOL_ACCESS_KEY_ID=625729a08b95bf1b7ff351a663f3a23c
S3_PROTOCOL_ACCESS_KEY_SECRET=850181e4652dd023b7a98c58ae0d2d34bd487ee0cc3254aed6eda37307425907
IMGPROXY_AUTO_WEBP=true
